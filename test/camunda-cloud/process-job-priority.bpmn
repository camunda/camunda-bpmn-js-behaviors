<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1"
  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:serviceTask id="ServiceTaskWithJobPriority" name="ServiceTaskWithJobPriority">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="a" />
        <zeebe:jobPriorityDefinition priority="50" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BusinessRuleTaskWithJobPriority"
      name="BusinessRuleTaskWithJobPriority">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="a" />
        <zeebe:jobPriorityDefinition priority="50" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="BusinessRuleTask_2" name="BusinessRuleTask_2">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="a" resultVariable="b" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="ScriptTaskWithJobPriority" name="ScriptTaskWithJobPriority">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="a" />
        <zeebe:jobPriorityDefinition priority="50" />
      </bpmn:extensionElements>
    </bpmn:scriptTask>
    <bpmn:endEvent id="MessageEndEventWithJobPriority" name="MessageEndEventWithJobPriority">
      <bpmn:messageEventDefinition />
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="a" />
        <zeebe:jobPriorityDefinition priority="50" />
      </bpmn:extensionElements>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="ServiceTaskWithJobPriority_di" bpmnElement="ServiceTaskWithJobPriority">
        <dc:Bounds x="160" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape
        id="BusinessRuleTaskWithJobPriority_di" bpmnElement="BusinessRuleTaskWithJobPriority">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape
        id="BusinessRuleTask_2_di" bpmnElement="BusinessRuleTask_2">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape
        id="ScriptTaskWithJobPriority_di" bpmnElement="ScriptTaskWithJobPriority">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape
        id="MessageEndEventWithJobPriority_di" bpmnElement="MessageEndEventWithJobPriority">
        <dc:Bounds x="730" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>