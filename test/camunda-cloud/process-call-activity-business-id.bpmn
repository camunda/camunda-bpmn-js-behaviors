        <dc:Bounds x="160" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallActivityWithEmptyBusinessId_di" bpmnElement="CallActivityWithEmptyBusinessId">
        <dc:Bounds x="160" y="200" width="100" height="80" />
